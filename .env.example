# ==========================================================================
# Ortam değişkeni ŞABLONU — bu dosya commit EDİLİR, değer İÇERMEZ.
#
# Kullanım : cp .env.example .env  → sonra .env içini doldur
# Kural    : .env asla commit edilmez (docs/standards/05-auth-security.md)
# Ortamlar : aynı anahtarın local / preview / production değeri FARKLIDIR.
#            Canlı anahtar local'de kullanılmaz (docs/standards/13-environments.md)
# Doğrulama: src/config/env.ts bu listeyi Zod ile doğrular; eksik zorunlu
#            değişkende uygulama AÇILIŞTA net hata verir
#
# Aşağıdaki "(adım N)" notları docs/project/roadmap.md adımlarına işaret eder.
# O adıma gelinene kadar değişken boş bırakılabilir.
# ==========================================================================

# --- Veritabanı (adım 2) --------------------------------------------------
# local    : aşağıdaki docker-compose.yml Postgres'i (iki değer de aynıdır)
# preview  : Neon `preview` dalı · production: Neon `production` dalı
#            Neon'da DATABASE_URL havuzlu (-pooler), DIRECT_URL havuzsuz adrestir.
DATABASE_URL=postgresql://belediye:belediye@localhost:5432/benim_belediyem
DIRECT_URL=postgresql://belediye:belediye@localhost:5432/benim_belediyem

# docker-compose.yml bunları okur; boş bırakılırsa yukarıdaki varsayılanlar geçerli olur.
# Bu değerler yalnızca kendi bilgisayarındaki kaptadır, canlıyla ilgisi yoktur.
POSTGRES_USER=belediye
POSTGRES_PASSWORD=belediye
POSTGRES_DB=benim_belediyem
POSTGRES_PORT=5432

# --- Uygulama (adım 0) ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV_LABEL=local        # local | preview | production → ekrandaki ortam şeridi

# --- Kimlik (adım 4b / 4c) ------------------------------------------------
AUTH_SECRET=                       # en az 32 bayt, her ortamda farklı
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kimlik numarası şifreleme (adım 3'ten itibaren ZORUNLU) --------------
# data-model.md → User.nationalIdEncrypted / nationalIdHash
# Tohumlama (prisma db seed) bu ikisi olmadan çalışmaz: sahte üyelerin kimlik
# numarası şifrelenip özetlenerek yazılır, düz metin kolon yoktur.
#
# Aşağıdaki değerler YALNIZCA LOCAL GELİŞTİRME içindir ve herkese açıktır —
# tıpkı yukarıdaki `belediye:belediye` veritabanı şifresi gibi. Preview ve
# production'da Vercel panelinden ORTAMA ÖZEL, gizli değer girilir; bu değerler
# oraya asla taşınmaz (docs/standards/13-environments.md).
# Yeni değer üretmek için: openssl rand -base64 32
NATIONAL_ID_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHkta2V5LTMyLWJ5dGVzLXh4eHg=
NATIONAL_ID_HASH_SALT=local-dev-only-salt

# --- Sahte KPS ucu (adım 4a'dan itibaren ZORUNLU) -------------------------
# /api/mock-kps/* ucu bu başlık olmadan 401 döner (ADR-009).
# Uç herkese açık bir adreste durur ve depo public'tir; koruma yalnızca bu
# anahtardan gelir. Bu yüzden preview ve production'da MUTLAKA farklı, gizli
# bir değer girilir — aşağıdaki değer yalnızca local içindir ve herkese açıktır.
# Yeni değer üretmek için: openssl rand -base64 32
MOCK_KPS_API_KEY=local-dev-only-mock-kps-key-not-a-secret

# --- Dış bilgi servisleri (adım 14) ---------------------------------------
# ANAHTAR GEREKMİYOR. Hava (Open-Meteo), döviz (Frankfurter), kripto (CoinGecko)
# ve haber (RSS — ADR-016) sağlayıcılarının dördü de anahtarsız çalışıyor.
# Aşağıdaki iki değer yalnızca hangi şehrin hava durumunun gösterileceğini
# belirler; verilmezse İzmir varsayılıyor.
WEATHER_DEFAULT_LAT=38.4237
WEATHER_DEFAULT_LON=27.1428

# --- Dosya depolama (adım 13) ---------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- İzleme (adım 18) -----------------------------------------------------
SENTRY_DSN=

# --- Planlı görevler (adım 16) --------------------------------------------
CRON_SECRET=                       # /api/cron/* uçlarını korur; eşleşmezse 401

# --- Yasal sayfalar: veri sorumlusu (adım 17) ------------------------------
# KVKK aydınlatma metninde ve başvuru kanalında görünen GERÇEK kişi/kurum.
# ⛔ DEĞERLER ASLA COMMIT EDİLMEZ — depo herkese açık. Boş bırakılırsa yasal
# sayfalar başvuru kanalı olarak yalnızca kaynak kodu deposunu gösterir.
LEGAL_CONTROLLER_NAME=             # örn. "Ad Soyad" — siteyi işleten gerçek kişi
LEGAL_CONTACT_EMAIL=               # KVKK başvurularının ulaşacağı adres

# --- Doğrulama kodu kanalları (adım 4b) -----------------------------------
# mock      : kod EKRANDA gösterilir, gönderim yapılmaz → yalnızca local ve preview
# email     : gerçek e-posta gönderimi (EMAIL_API_KEY + EMAIL_FROM gerekir)
# email_sim : telefon kodu "SMS simülasyonu" başlığıyla E-POSTAYA gider (PRD §5.0)
#
# PRODUCTION'DA `mock` SEÇİLEMEZ — uygulama açılışta net hatayla durur.
# Gerekçe: sahte kanal kodu ekrana basar, `05-auth-security.md` bunu production'da
# kesin olarak yasaklıyor. Yanlış yapılandırılmış bir dağıtımın hiç açılmaması,
# kodu herkese göstermesinden iyidir.
#
# `sms` değeri hiçbir ortamda kullanılamaz: gerçek SMS sağlayıcısı PRD §2 uyarınca
# kapsam dışı. Sağlayıcı eklenirse bu satır ve `OtpChannel` uygulaması değişir.
OTP_EMAIL_CHANNEL=mock             # local/preview: mock · production: email
OTP_PHONE_CHANNEL=mock             # local/preview: mock · production: email_sim

# EMAIL_API_KEY boşsa uygulama AÇILIR ama kayıt ucu 503 döner ve kayıt ekranı
# "kayıt geçici olarak kapalı" mesajı gösterir. Böylece anahtar girilmeden de
# `main` deploy edilebilir kalır (CLAUDE.md §6.1).
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_KEY=                  # şu an kullanılmıyor, ileride gerçek SMS için

# --- Bot koruması · Cloudflare Turnstile (adım 4b) ------------------------
# Aşağıdakiler Cloudflare'ın RESMÎ TEST anahtarlarıdır: herkese açıktır, gizli
# değildir ve doğrulama her zaman başarılı döner. Local'de kullanılır.
#
# Preview ve production'da kendi anahtarlarınızı girin (dash.cloudflare.com →
# Turnstile → Add site, "Managed" modu). Ortamlar anahtar PAYLAŞMAZ.
#
# Anahtar yoksa davranış ortama göre değişir (ADR-004):
#   local   → doğrulama atlanır
#   preview → aşağıdaki test anahtarları kullanılır (kapı gerçek bot'u durdurmaz)
#   production → kayıt ucu 503 döner, kapı ASLA atlanmaz
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Proje sahibi hesabı (adım 3'ten itibaren okunur) ---------------------
# DEĞERLER ASLA COMMIT EDİLMEZ — depo herkese açık (PRD.md §5.0)
#
# Hepsi boşsa tohumlama bu hesabı ATLAR ve hatasız tamamlanır.
# Biri doluysa hepsi dolu olmalı; eksikse tohumlama açık hata verir.
# OWNER_BIRTH_DATE gerekli çünkü kayıt akışı kimlik numarasının yanında doğum
# yılını ikinci doğrulama alanı olarak sorar (PRD §5.0 kayıt akışı, adım 1).
OWNER_TCKN=
OWNER_FULL_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_BIRTH_DATE=                  # YYYY-MM-DD
