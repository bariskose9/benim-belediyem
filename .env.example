# ==========================================================================
# Ortam değişkeni ŞABLONU — bu dosya commit EDİLİR, değer İÇERMEZ.
#
# Kullanım : cp .env.example .env  → sonra .env içini doldur
# Kural    : .env asla commit edilmez (docs/standards/05-auth-security.md)
# Ortamlar : aynı anahtarın local / preview / production değeri FARKLIDIR.
#            Canlı anahtar local'de kullanılmaz (docs/standards/13-environments.md)
# Doğrulama: src/config/env.ts bu listeyi Zod ile doğrular; eksik zorunlu
#            değişkende uygulama AÇILIŞTA net hata verir
#
# Aşağıdaki "(adım N)" notları docs/project/roadmap.md adımlarına işaret eder.
# O adıma gelinene kadar değişken boş bırakılabilir.
# ==========================================================================

# --- Veritabanı (adım 2) --------------------------------------------------
# local    : docker-compose.yml'deki Postgres
# preview  : Neon `preview` dalı · production: Neon `main` dalı
DATABASE_URL=
DIRECT_URL=                        # Prisma migration için havuzsuz bağlantı

# --- Uygulama (adım 0) ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV_LABEL=local        # local | preview | production → ekrandaki ortam şeridi

# --- Kimlik (adım 4b / 4c) ------------------------------------------------
AUTH_SECRET=                       # en az 32 bayt, her ortamda farklı
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kimlik numarası şifreleme (adım 4b) ----------------------------------
# data-model.md → User.nationalIdEncrypted
NATIONAL_ID_ENCRYPTION_KEY=        # 32 bayt, ortamlar arası PAYLAŞILMAZ
NATIONAL_ID_HASH_SALT=             # arama için tuzlanmış özet

# --- Dış bilgi servisleri (adım 14) ---------------------------------------
NEWS_API_KEY=
NEWS_API_PROVIDER=gnews
WEATHER_DEFAULT_LAT=38.4237
WEATHER_DEFAULT_LON=27.1428

# --- Dosya depolama (adım 13) ---------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- İzleme (adım 18) -----------------------------------------------------
SENTRY_DSN=

# --- Planlı görevler (adım 16) --------------------------------------------
CRON_SECRET=                       # /api/cron/* uçlarını korur; eşleşmezse 401

# --- Doğrulama kodu kanalları (adım 4b) -----------------------------------
OTP_EMAIL_CHANNEL=mock             # mock | email           → e-posta kodu
OTP_PHONE_CHANNEL=mock             # mock | email_sim | sms → telefon kodu
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_KEY=                  # şu an kullanılmıyor, ileride gerçek SMS için

# --- Bot koruması · Cloudflare Turnstile (adım 4b) ------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Proje sahibi hesabı (adım 4b) ----------------------------------------
# DEĞERLER ASLA COMMIT EDİLMEZ — depo herkese açık (PRD.md §5.0)
OWNER_TCKN=
OWNER_FULL_NAME=
OWNER_EMAIL=
OWNER_PHONE=
