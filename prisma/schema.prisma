// ===========================================================================
// SAHTE KPS — dış servis simülasyonu, uygulama tablolarından AYRI
// ===========================================================================

/// Taklit edilen DIŞ KURUM veritabanı (ADR-003). Uygulama buraya JOIN atmaz;
/// yalnızca /api/mock-kps/* ucu üzerinden okur.
///
/// `nationalId` burada DÜZ METİNDİR ve bu bilinçlidir: gerçek KPS de numarayı
/// düz tutar, yoksa numarayla sorgulanamaz. Uygulamanın kendi tablolarında
/// (User, StaffMember) düz metin kimlik numarası kolonu YOKTUR —
/// docs/standards/05-auth-security.md "Kimlik verisinin saklanması".
/// Bu tablodaki kayıtların tamamı sentetiktir ve hiçbir gerçek kişiyi temsil etmez.
model KpsCitizen {
  id                 String             @id @default(cuid())
  nationalId         String             @unique @map("national_id")
  firstName          String             @map("first_name")
  lastName           String             @map("last_name")
  birthDate          DateTime           @map("birth_date") @db.Date
  birthPlace         String             @map("birth_place")
  fatherName         String             @map("father_name")
  motherName         String             @map("mother_name")
  registeredProvince String             @map("registered_province")
  registeredDistrict String             @map("registered_district")
  gender             Gender
  maritalStatus      MaritalStatus      @map("marital_status")
  registeredAddress  String             @map("registered_address")
  simulationBehavior SimulationBehavior @default(normal) @map("simulation_behavior")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  @@index([simulationBehavior])
  @@map("kps_citizens")
}

// ===========================================================================
// ÇEKİRDEK
// ===========================================================================

/// Kimlik numarası ÜÇ kolonda tutulur ve hiçbiri düz metin değildir:
///   nationalIdEncrypted → şifreli değer (rastgele nonce ile; her seferinde farklı)
///   nationalIdHash      → aramak ve tekilliği zorlamak için tuzlanmış özet (unique)
///   nationalIdMasked    → ekranda gösterilecek maskeli hali (123*****90)
/// Şifreli kolon unique DEĞİLDİR: doğru şifreleme aynı girdiden her seferinde
/// farklı çıktı üretir, dolayısıyla üzerinde unique index çalışmaz. Tekilliği
/// özet kolonu sağlar (NATIONAL_ID_HASH_SALT ile).
///
/// role, identityStatus ve isStaff YALNIZCA sunucuda hesaplanır; istemciden
/// gelen değer yok sayılır (05-auth-security.md "Yetki kaynağı").
model User {
  id                  String         @id @default(cuid())
  nationalIdEncrypted String?        @map("national_id_encrypted")
  nationalIdHash      String?        @unique @map("national_id_hash")
  nationalIdMasked    String?        @map("national_id_masked")
  fullName            String         @map("full_name")
  birthDate           DateTime?      @map("birth_date") @db.Date
  email               String?        @unique
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  phone               String?
  phoneVerifiedAt     DateTime?      @map("phone_verified_at")
  passwordHash        String?        @map("password_hash")
  role                UserRole       @default(user)
  identityStatus      IdentityStatus @default(unverified) @map("identity_status")
  isStaff             Boolean        @default(false) @map("is_staff")
  staffMemberId       String?        @unique @map("staff_member_id")

  // Nüfus adresinin TAMAMI saklanmaz — yalnızca il/ilçe (veri minimizasyonu).
  registeredProvince String?   @map("registered_province")
  registeredDistrict String?   @map("registered_district")
  kpsSyncedAt        DateTime? @map("kps_synced_at")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  staffMember      StaffMember?      @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  accounts         Account[]
  sessions         Session[]
  otpChallenges    OtpChallenge[]
  addresses        Address[]
  notifications    Notification[]
  carts            Cart[]
  orders           Order[]
  savedCards       SavedCard[]
  payments         Payment[]
  appointments     Appointment[]
  seatReservations SeatReservation[]
  memberships      Membership[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]
  consentRecords   ConsentRecord[]

  @@index([role])
  @@index([identityStatus])
  @@index([isStaff])
  @@index([deletedAt])
  @@map("users")
}

/// Auth.js hesap tablosu — giriş yöntemlerini tutar (credentials / google).
/// Ayrı bir `AuthMethod` tablosu YOKTUR; Account zaten aynı işi yapar.
///
/// DİKKAT — `refresh_token`, `access_token`, `expires_at`, `token_type`,
/// `id_token`, `session_state` alan adları bilerek snake_case'tir. Auth.js'in
/// Prisma adaptörü OAuth sağlayıcısından gelen nesneyi doğrudan Prisma'ya
/// yazar; alan adları birebir bunlar olmazsa adaptör çalışmaz. Bu, proje
/// isimlendirme kuralının dış kütüphane sözleşmesi karşısındaki tek istisnasıdır.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Veritabanı oturumu (ADR-005). JWT değil: anında iptal edilebilirlik için.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @map("expires_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

/// Auth.js doğrulama jetonu tablosu — adaptör sözleşmesi gereği bulunur.
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime @map("expires_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

/// Tek kullanımlık kod. Kod ve hedef adres DÜZ METİN saklanmaz — yalnızca özet
/// (05-auth-security.md "Tek kullanımlık kod (OTP) kuralları").
/// `userId` nullable: kayıt akışında henüz hesap yoktur, kod geçici kayıt
/// kimliğine (`registrationId`) bağlanır.
model OtpChallenge {
  id              String     @id @default(cuid())
  userId          String?    @map("user_id")
  registrationId  String?    @map("registration_id")
  purpose         OtpPurpose
  channel         OtpChannel
  destinationHash String     @map("destination_hash")
  codeHash        String     @map("code_hash")
  expiresAt       DateTime   @map("expires_at")
  attemptCount    Int        @default(0) @map("attempt_count")
  consumedAt      DateTime?  @map("consumed_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([registrationId])
  @@index([expiresAt])
  @@index([destinationHash, purpose])
  @@map("otp_challenges")
}

/// Yarım kalmış kayıt işlemi — KPS yanıtının kısa ömürlü önbelleği (ADR-012).
///
/// PRD §5.0: "Tam KPS yanıtı en fazla 15 dakika önbellekte tutulur. Önbellek
/// anahtarı kimlik numarası DEĞİL, oturuma bağlı rastgele bir kimliktir."
/// Sunucusuz ortamda bellek içi önbellek çalışmadığı için (ADR-006'daki aynı
/// gerekçe) önbellek burada, kısa ömürlü bir satır olarak duruyor.
///
/// DÜZ METİN HİÇBİR ŞEY YOK: kimlik numarası, e-posta, telefon ve KPS yanıtı
/// ya şifreli (AES-256-GCM) ya da tuzlanmış özet olarak saklanır.
///
/// `tokenHash`: çerezdeki jetonun kendisi DEĞİL, SHA-256 özeti tutulur. Böylece
/// veritabanı dökümü tek başına kullanılabilir bir çerez vermez.
///
/// FK YOK — `otp_challenges.registration_id` buraya bağlanmıyor. Taslak hesap
/// açılınca siliniyor ama kod kayıtları denetim ve gönderim hız sınırı için
/// yaşamaya devam etmeli; Cascade onları silerdi, SetNull bağı koparırdı.
/// `04-database.md`'nin yabancı anahtar kuralı bu kısa ömürlü ebeveyn için
/// bilinçli olarak esnetildi (ADR-012).
model RegistrationDraft {
  id                  String  @id @default(cuid())
  tokenHash           String  @unique @map("token_hash")
  nationalIdHash      String  @map("national_id_hash")
  kpsPayloadEncrypted String  @map("kps_payload_encrypted")
  contactEncrypted    String? @map("contact_encrypted")
  emailHash           String? @map("email_hash")
  phoneHash           String? @map("phone_hash")
  passwordHash        String? @map("password_hash")
  actorIpHash         String  @map("actor_ip_hash")

  expiresAt DateTime @map("expires_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  @@index([expiresAt])
  @@index([nationalIdHash])
  @@map("registration_drafts")
}

/// Hız sınırı sayacı (ADR-006 — Redis yerine Postgres).
/// `key` kişisel veri İÇERMEZ: amaç + tuzlanmış IP/kimlik özeti.
/// unique(key, windowStartedAt): aynı pencerede ikinci sayaç satırı açılamaz,
/// böylece eşzamanlı istekler sayacı sıfırlayamaz.
model RateLimitCounter {
  id              String   @id @default(cuid())
  key             String
  windowStartedAt DateTime @map("window_started_at")
  count           Int      @default(0)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  @@unique([key, windowStartedAt])
  @@index([windowStartedAt])
  @@map("rate_limit_counters")
}

/// KPS sorgu denetim kaydı — append-only, updatedAt yok.
/// SORGULANAN KİMLİK NUMARASI İÇİN KOLON YOKTUR: olmayan kolona yanlışlıkla
/// yazılamaz (05-auth-security.md "Her sorgu denetim kaydına yazılır —
/// sorgulanan numara yazılmadan").
model KpsQueryLog {
  id          String         @id @default(cuid())
  actorIpHash String         @map("actor_ip_hash")
  sessionId   String?        @map("session_id")
  result      KpsQueryResult
  durationMs  Int            @map("duration_ms")

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  @@index([createdAt])
  @@index([result])
  @@map("kps_query_logs")
}

/// Teslimat adresi — nüfus adresinden ayrıdır, kullanıcı kendi girer.
model Address {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  title       String
  fullAddress String @map("full_address")
  district    String

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

model Notification {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  type        NotificationType
  title       String
  body        String
  isRead      Boolean            @default(false) @map("is_read")
  relatedType RelatedEntityType? @map("related_type")
  relatedId   String?            @map("related_id")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ===========================================================================
// SEPET, SİPARİŞ VE ÖDEME
// ===========================================================================

/// `userId` nullable: ziyaretçi de sepete ürün ekleyebilir. Ziyaretçi sepeti
/// çerezdeki `anonymousId` ile taşınır, giriş yapılınca birleştirilir (PRD §4).
model Cart {
  id          String     @id @default(cuid())
  userId      String?    @map("user_id")
  anonymousId String?    @map("anonymous_id")
  status      CartStatus @default(active)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([anonymousId])
  @@index([status, updatedAt])
  @@map("carts")
}

/// unique(cartId, itemType, refId): aynı ürün sepete iki ayrı satır olarak
/// giremez — adet artırılır. Sepet birleştirmede (ziyaretçi → üye) de bu kural
/// çift satır oluşmasını veritabanı seviyesinde engeller.
model CartItem {
  id        String       @id @default(cuid())
  cartId    String       @map("cart_id")
  itemType  CartItemType @map("item_type")
  refId     String       @map("ref_id")
  quantity  Int
  unitPrice Decimal      @map("unit_price") @db.Decimal(10, 2)
  note      String?

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, itemType, refId])
  @@index([cartId])
  @@map("cart_items")
}

/// Karışık sepet tek ödemeyle BİRDEN FAZLA sipariş üretir — modül başına bir
/// tane. Aynı ödemeye bağlı siparişler aynı `paymentId`'yi paylaşır (PRD §6.1).
/// `ticket` türünde teslimat alanları boştur ve durum doğrudan `delivered` olur.
model Order {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  paymentId         String          @map("payment_id")
  fulfillmentType   FulfillmentType @map("fulfillment_type")
  subtotalAmount    Decimal         @map("subtotal_amount") @db.Decimal(10, 2)
  deliveryFee       Decimal         @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount    Decimal         @map("discount_amount") @db.Decimal(10, 2)
  totalAmount       Decimal         @map("total_amount") @db.Decimal(10, 2)
  status            OrderStatus     @default(received)
  cancelledAt       DateTime?       @map("cancelled_at")
  cancelReason      String?         @map("cancel_reason")
  /// Kullanıcıya EN SON HANGİ DURUM İÇİN bildirim gönderildiği (ADR-013).
  /// Durum bir zamanlayıcı değil, siparişin yaşı belirliyor; bildirim ise
  /// kalıcı olmak zorunda. Bu kolon ikisini birleştiriyor: liste okunurken
  /// hesaplanan durum bu değerden ileriyse aradaki bildirimler o anda
  /// yazılıyor ve kolon KOŞULLU UPDATE ile ilerletiliyor. Koşul `WHERE`'in
  /// içinde olduğu için iki eşzamanlı okuma aynı bildirimi iki kez yazamaz.
  notifiedStatus    OrderStatus?    @map("notified_status")
  deliveryAddressId String?         @map("delivery_address_id")
  // Teslimat zaman aralığı serbest metindir ("2026-08-02 10:00-12:00"): sabit
  // bir sözlüğü yoktur ve bu fazda üzerinden zaman sorgusu yapılmaz.
  deliverySlot      String?         @map("delivery_slot")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment         Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  deliveryAddress Address?    @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  refund          Refund?

  @@index([userId, createdAt])
  @@index([paymentId])
  @@index([status])
  @@map("orders")
}

/// Fiyat sipariş anında KOPYALANIR; ürün fiyatı sonradan değişirse geçmiş
/// sipariş bozulmaz.
model OrderItem {
  id        String       @id @default(cuid())
  orderId   String       @map("order_id")
  itemType  CartItemType @map("item_type")
  refId     String       @map("ref_id")
  quantity  Int
  unitPrice Decimal      @map("unit_price") @db.Decimal(10, 2)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// TAM KART NUMARASI ASLA SAKLANMAZ — yalnızca son 4 hane (05-auth-security.md).
model SavedCard {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  brand      CardBrand
  last4      String
  expMonth   Int       @map("exp_month")
  expYear    Int       @map("exp_year")
  holderName String    @map("holder_name")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments    Payment[]
  memberships Membership[]

  @@index([userId])
  @@index([deletedAt])
  @@map("saved_cards")
}

/// Ödeme BAĞIMSIZ bir kayıttır; siparişler ona bağlanır — tersi değil. Böylece
/// bir ödeme birden fazla siparişi karşılayabilir. Append-only: updatedAt yok.
///
/// unique(idempotencyKey): çift tıklama, yeniden deneme veya ağ kopması
/// sonrası tekrarlanan istek İKİNCİ KEZ TAHSİLAT YAPAMAZ. Bu kontrol
/// uygulamada değil veritabanında durur; "önce kontrol et sonra yaz" iki
/// eşzamanlı istekte yetersizdir (04-database.md "Eşzamanlılık").
model Payment {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  savedCardId       String?       @map("saved_card_id")
  brand             CardBrand
  cardLast4         String        @map("card_last4")
  fakeTransactionId String        @unique @map("fake_transaction_id")
  status            PaymentStatus
  amount            Decimal       @db.Decimal(10, 2)
  idempotencyKey    String        @unique @map("idempotency_key")
  attemptedAt       DateTime      @map("attempted_at")

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  savedCard SavedCard? @relation(fields: [savedCardId], references: [id], onDelete: Restrict)
  orders    Order[]
  refunds   Refund[]

  @@index([userId, attemptedAt])
  @@index([status])
  @@map("payments")
}

/// SAHTE İADE KAYDI (PRD §5.5: "iptal edildiğinde sahte iade kaydı oluşur").
///
/// Gerçek bir ödeme sağlayıcısı olmadığı için para hareketi yoktur; kayıt
/// "şu sipariş iptal edildi ve şu tutar iade edildi" olgusunu belgeler ve
/// kullanıcıya ekranda gösterilir. `payments` gibi APPEND-ONLY.
///
/// `order_id` BENZERSİZ ve bu bir iş kuralıdır, kolaylık değil: aynı siparişe
/// ikinci bir iade yazılamaz. Çift iptal isteğinde kararı uygulama değil
/// VERİTABANI verir — "önce iade var mı diye bak, yoksa yaz" iki adımdır ve
/// iki eşzamanlı istekte yetersizdir (data-model.md).
model Refund {
  id           String  @id @default(cuid())
  orderId      String  @unique @map("order_id")
  paymentId    String  @map("payment_id")
  amount       Decimal @db.Decimal(10, 2)
  fakeRefundId String  @unique @map("fake_refund_id")
  reason       String?

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([createdAt])
  @@map("refunds")
}

// ===========================================================================
// SAĞLIK (personele özel)
// ===========================================================================

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  doctors Doctor[]

  @@map("specialties")
}

model Doctor {
  id          String      @id @default(cuid())
  specialtyId String      @map("specialty_id")
  fullName    String      @map("full_name")
  title       DoctorTitle

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  specialty Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  slots     DoctorSlot[]

  @@unique([specialtyId, fullName])
  @@index([specialtyId])
  @@map("doctors")
}

/// unique(doctorId, startsAt): AYNI DOKTORA AYNI SAATTE İKİNCİ SLOT AÇILAMAZ.
/// Randevu alma işlemi bu satırı `isBooked = false` koşuluyla günceller
/// (koşullu UPDATE + transaction); "önce boş mu diye bak, sonra yaz" iki
/// eşzamanlı istekte aynı saati iki kişiye verirdi.
model DoctorSlot {
  id       String   @id @default(cuid())
  doctorId String   @map("doctor_id")
  startsAt DateTime @map("starts_at")
  isBooked Boolean  @default(false) @map("is_booked")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([doctorId, startsAt])
  @@index([startsAt, isBooked])
  @@map("doctor_slots")
}

/// `slotId` bilerek unique DEĞİL: iptal edilen randevu 3 yıl saklanır ve aynı
/// slot yeniden satılabilir, o zaman aynı slota biri iptal biri aktif iki kayıt
/// düşer. Aktif randevunun tekilliğini `DoctorSlot.isBooked` üzerindeki koşullu
/// güncelleme sağlar.
model Appointment {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  slotId      String            @map("slot_id")
  status      AppointmentStatus @default(booked)
  cancelledAt DateTime?         @map("cancelled_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  slot DoctorSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([slotId])
  @@map("appointments")
}

// ===========================================================================
// ETKİNLİK
// ===========================================================================

model Venue {
  id      String @id @default(cuid())
  name    String @unique
  address String

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  seats  VenueSeat[]
  events Event[]

  @@map("venues")
}

model VenueSeat {
  id         String @id @default(cuid())
  venueId    String @map("venue_id")
  block      String
  rowLabel   String @map("row_label")
  seatNumber Int    @map("seat_number")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  venue        Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]

  @@unique([venueId, block, rowLabel, seatNumber])
  @@index([venueId])
  @@map("venue_seats")
}

model Event {
  id        String        @id @default(cuid())
  venueId   String        @map("venue_id")
  name      String
  category  EventCategory
  performer String
  startsAt  DateTime      @map("starts_at")
  basePrice Decimal       @map("base_price") @db.Decimal(10, 2)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  venue        Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  reservations SeatReservation[]

  @@index([venueId])
  @@index([startsAt])
  @@index([category])
  @@map("events")
}

/// unique(eventId, seatId): AYNI KOLTUK İKİ KEZ SATILAMAZ. İki kullanıcı aynı
/// anda denerse biri veritabanı hatası alır ve uygulama 409 döner (PRD §5.2).
///
/// Süresi dolmuş `held` kayıt okuma anında yok sayılır (ADR-007); koltuğu
/// yeniden satmak için o satır aynı transaction içinde güncellenir —
/// `holdExpiresAt` bu yüzden indekslidir.
model SeatReservation {
  id            String                @id @default(cuid())
  eventId       String                @map("event_id")
  seatId        String                @map("seat_id")
  userId        String                @map("user_id")
  status        SeatReservationStatus @default(held)
  holdExpiresAt DateTime?             @map("hold_expires_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  event Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat  VenueSeat @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, seatId])
  @@index([userId])
  @@index([eventId, status])
  @@index([holdExpiresAt])
  @@map("seat_reservations")
}

