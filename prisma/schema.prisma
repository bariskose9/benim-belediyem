// Şemanın TEK kaynağı burasıdır (docs/standards/04-database.md).
// Veritabanına elle tablo/kolon eklenmez; her değişiklik migration ile yapılır.
//
// Kaynak: docs/project/data-model.md · kurallar: docs/standards/04-database.md
//
// İSİMLENDİRME
//   model  → PascalCase tekil        (Appointment)
//   tablo  → @@map ile çoğul snake   (appointments)
//   kolon  → @map ile snake_case     (created_at)
//   FK     → <tekil>_id              (user_id)
//   enum   → değerler İngilizce; kullanıcıya gösterilen karşılıkları src/config/ altında
//
// HER TABLODA
//   id · createdAt · updatedAt · isSeedData
//   (append-only tablolarda updatedAt YOKTUR: güncellenmeyen kayıtta anlamsızdır
//    ve "hiç değişmedi" güvencesini zayıflatır)
//   deletedAt yalnızca data-model.md'nin saydığı 8 tabloda: User, Address,
//   SupportTicket, SavedCard, Product, MenuItem, StaffMember, OrgUnit
//
// PARA
//   Decimal(10,2) — float ASLA (0.1 + 0.2 != 0.3 hatası parada kabul edilemez)
//
// SİLME DAVRANIŞI
//   Cascade  → üst kayıt gidince anlamı kalmayan alt kayıt (sepet kalemi, oturum)
//   Restrict → mali değeri veya denetim değeri olan her şey (sipariş, ödeme, üyelik)
//   Zaten varsayılan silme yöntemi soft delete'tir; Restrict "yanlışlıkla silinmesin" der.

generator client {
  // Prisma 7'de `prisma-client-js` deprecated; yeni projelerde `prisma-client`
  // kullanılır ve `output` ZORUNLUDUR.
  // https://www.prisma.io/docs/orm/prisma-schema/overview/generators
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // package.json "type": "module" olduğu için üretilen kod da ESM olmalı.
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Prisma 7'de `url` ve `directUrl` şemadan KALDIRILDI:
  //   · migration adresi → prisma.config.ts (havuzsuz DIRECT_URL)
  //   · uygulama adresi  → src/lib/db.ts içindeki driver adapter (havuzlu DATABASE_URL)
  // Gerekçe: docs/project/decisions/ADR-008-prisma-driver-adapter.md
}

// ===========================================================================
// ENUM'LAR
