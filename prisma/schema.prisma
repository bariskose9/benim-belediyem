// ===========================================================================
// SPOR SALONU (personele özel)
// ===========================================================================

/// `discountPercent` TUTULMAZ: indirim, taahhütsüz paketin fiyatından hesaplanıp
/// yalnızca ekranda gösterilir. İki alan tutmak sapma riski yaratır (data-model.md).
model MembershipPlan {
  id               String  @id @default(cuid())
  name             String  @unique
  commitmentMonths Int     @map("commitment_months")
  monthlyPrice     Decimal @map("monthly_price") @db.Decimal(10, 2)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  memberships        Membership[] @relation("MembershipPlanCurrent")
  pendingMemberships Membership[] @relation("MembershipPlanPending")

  @@map("membership_plans")
}

/// Paket değişimi bir SONRAKİ tahsilat tarihinde yürürlüğe girer (PRD §5.6);
/// bekleyen paket bu yüzden ayrı iki alanda tutulur.
model Membership {
  id                     String           @id @default(cuid())
  userId                 String           @map("user_id")
  planId                 String           @map("plan_id")
  savedCardId            String?          @map("saved_card_id")
  startsAt               DateTime         @map("starts_at")
  commitmentEndsAt       DateTime?        @map("commitment_ends_at")
  status                 MembershipStatus @default(active)
  autoRenewEnabled       Boolean          @default(true) @map("auto_renew_enabled")
  nextBillingAt          DateTime?        @map("next_billing_at")
  cancelledAt            DateTime?        @map("cancelled_at")
  pendingPlanId          String?          @map("pending_plan_id")
  pendingPlanEffectiveAt DateTime?        @map("pending_plan_effective_at")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan        MembershipPlan      @relation("MembershipPlanCurrent", fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan MembershipPlan?     @relation("MembershipPlanPending", fields: [pendingPlanId], references: [id], onDelete: Restrict)
  savedCard   SavedCard?          @relation(fields: [savedCardId], references: [id], onDelete: Restrict)
  payments    MembershipPayment[]

  @@index([userId])
  @@index([planId])
  @@index([status, nextBillingAt])
  @@map("memberships")
}

/// unique(membershipId, periodStart): ÇİFT TAHSİLATI VERİTABANI SEVİYESİNDE
/// ENGELLER. Günlük yenileme görevi iki kez çalışsa bile ikinci satır yazılamaz
/// (PRD §5.6 "Otomatik tahsilat zamanı"). Append-only: updatedAt yok.
model MembershipPayment {
  id             String                  @id @default(cuid())
  membershipId   String                  @map("membership_id")
  periodStart    DateTime                @map("period_start")
  periodEnd      DateTime                @map("period_end")
  amount         Decimal                 @db.Decimal(10, 2)
  kind           MembershipPaymentKind
  status         MembershipPaymentStatus
  attemptedAt    DateTime                @map("attempted_at")
  idempotencyKey String                  @unique @map("idempotency_key")

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([membershipId, periodStart])
  @@index([membershipId])
  @@map("membership_payments")
}

// ===========================================================================
// KURUMSAL (Hakkımızda)
// ===========================================================================

/// Kendine referanslı ağaç: daire başkanlığı → şube müdürlüğü → şeflik.
model OrgUnit {
  id        String      @id @default(cuid())
  name      String
  unitType  OrgUnitType @map("unit_type")
  parentId  String?     @map("parent_id")
  sortOrder Int         @default(0) @map("sort_order")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  parent   OrgUnit?      @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrgUnit[]     @relation("OrgUnitTree")
  staff    StaffMember[]

  @@index([parentId])
  @@index([unitType])
  @@index([deletedAt])
  @@map("org_units")
}

/// Personel rehberi. `nationalIdHash` YALNIZCA personel eşleştirmesi içindir —
/// düz kimlik numarası saklanmaz (05-auth-security.md). Cep telefonu, adres,
/// doğum tarihi gibi kişisel alan TUTULMAZ; rehber yalnızca kurumsal iletişim
/// bilgisi gösterir (fake-data-guide.md "Gösterilmeyecekler").
model StaffMember {
  id              String     @id @default(cuid())
  orgUnitId       String     @map("org_unit_id")
  fullName        String     @map("full_name")
  title           StaffTitle
  workEmail       String     @unique @map("work_email")
  extensionNumber Int        @unique @map("extension_number")
  startYear       Int        @map("start_year")
  nationalIdHash  String?    @unique @map("national_id_hash")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  user    User?

  @@index([orgUnitId])
  @@index([title])
  @@index([fullName])
  @@index([deletedAt])
  @@map("staff_members")
}

// ===========================================================================
// DESTEK
// ===========================================================================

model SupportTicket {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  subject     String
  description String
  status      SupportTicketStatus @default(open)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  isSeedData Boolean   @default(false) @map("is_seed_data")
  deletedAt  DateTime? @map("deleted_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attachments TicketAttachment[]

  @@index([userId, status])
  @@index([deletedAt])
  @@map("support_tickets")
}

model TicketAttachment {
  id        String @id @default(cuid())
  ticketId  String @map("ticket_id")
  fileUrl   String @map("file_url")
  fileName  String @map("file_name")
  sizeBytes Int    @map("size_bytes")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

// ===========================================================================
// DENETİM VE GİZLİLİK
// ===========================================================================

/// Append-only: güncellenmez ve silinmez (04-database.md "Denetim ve saklama").
/// IP düz saklanmaz, özetlenir.
model AuditLog {
  id         String          @id @default(cuid())
  userId     String?         @map("user_id")
  action     AuditAction
  entityType AuditEntityType @map("entity_type")
  entityId   String?         @map("entity_id")
  ipHash     String          @map("ip_hash")

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Çerez rızası giriş yapmamış ziyaretçiden de alınır; o durumda rıza çerezdeki
/// rastgele `anonymousId`'ye bağlanır. Kullanıcı sonradan giriş yaparsa kayıt
/// hesabına bağlanır (PRD §5.10). Append-only.
model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  anonymousId String?     @map("anonymous_id")
  consentType ConsentType @map("consent_type")
  isGranted   Boolean     @map("is_granted")

  createdAt  DateTime @default(now()) @map("created_at")
  isSeedData Boolean  @default(false) @map("is_seed_data")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([anonymousId])
  @@map("consent_records")
}
